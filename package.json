{
  "name": "veritas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Veritas — Transparence des votes parlementaires français",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @veritas/e2e test:e2e",
    "db:generate": "pnpm --filter backend db:generate",
    "db:migrate": "pnpm --filter backend db:migrate",
    "db:studio": "pnpm --filter backend db:studio",
    "db:seed": "pnpm --filter backend db:seed",
    "etl:run": "pnpm --filter etl start",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "audit:tanstack": "node scripts/audit-tanstack-packages.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "h3": "^1.15.9",
      "zod": "^4.4.3"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@resvg/resvg-js"
    ]
  }
}
