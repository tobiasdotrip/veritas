{
  "name": "@veritas/frontend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --configLoader native",
    "build": "vite build --configLoader native",
    "start": "node dist/server/server.js",
    "typecheck": "tsc --noEmit",
    "routes:generate": "node --input-type=module -e \"import { Generator, getConfig } from '@tanstack/router-generator'; const c=getConfig({}, process.cwd()); await new Generator({ root: process.cwd(), config: c }).run();\"",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.10",
    "@radix-ui/react-dialog": "^1.1.13",
    "@radix-ui/react-select": "^2.2.4",
    "@radix-ui/react-tabs": "^1.1.11",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-router": "^1.170.5",
    "@tanstack/react-start": "^1.168.7",
    "@veritas/shared": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.509.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "satori": "^0.26.0",
    "tailwind-merge": "^3.2.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/router-generator": "^1.167.6",
    "@tanstack/router-plugin": "^1.168.7",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.0.0",
    "nanoid": "^5.1.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.4"
  }
}