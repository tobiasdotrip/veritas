NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Reverse proxy (comma-separated IPs/CIDRs; leave unset when not behind a proxy)
# TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8

# Database
DATABASE_URL=postgresql://veritas:veritas_dev@localhost:5432/veritas

# Redis
REDIS_URL=redis://:veritas_redis@localhost:6379

# ETL
ETL_ENABLED=true
ETL_SCRUTINS_URL=https://data.assemblee-nationale.fr/static/openData/repository/17/loi/scrutins/Scrutins.json.zip
ETL_DEPUTIES_URL=https://data.assemblee-nationale.fr/static/openData/repository/17/amo/deputes_senateurs_ministres_legislature/AMO20_dep_sen_min_tous_mandats_et_organes.json.zip
ETL_ORGANES_URL=https://data.assemblee-nationale.fr/static/openData/repository/17/amo/deputes_senateurs_ministres_legislature/AMO20_dep_sen_min_tous_mandats_et_organes.json.zip
ETL_TEMP_DIR=/tmp/an-etl
