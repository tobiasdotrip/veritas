    "@fastify/swagger-ui": "^5.2.2",
    "@veritas/shared": "workspace:*",
    "bullmq": "^5.76.8",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.7.1",
    "fastify": "^5.8.0",
    "fastify-type-provider-zod": "^4.0.4",
    "ioredis": "^5.10.1",
    "meilisearch": "^0.58.0",
    "pg": "^8.15.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vitest": "^3.1.0"
