{
  "name": "@veritas/etl",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "etl": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --config ../../eslint.config.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@veritas/shared": "workspace:*",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.45.2",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "node-stream-zip": "^1.15.0",
    "pg": "^8.15.0",
    "pg-copy-streams": "^6.0.6",
    "stream-json": "^1.9.1",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.0",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/unzipper": "^0.10.11",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
